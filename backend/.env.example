# Personal Finance Backend - Environment Configuration
# Copy this file to .env and fill in the values.

# Django secret key - generate a secure one for production!
# Python: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me-to-a-secure-key

# Debug mode - set to False in production!
DEBUG=True

# Database configuration
# For local development, use SQLite:
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3

# For PostgreSQL (production):
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=finance_db
# DB_USER=finance_user
# DB_PASSWORD=change-me
# DB_HOST=localhost
# DB_PORT=5432

# Allowed hosts - comma-separated list of domain names/IPs
ALLOWED_HOSTS=localhost,127.0.0.1

# CORS allowed origins - comma-separated list of frontend URLs
CORS_ALLOWED_ORIGINS=http://localhost:5173

# CSRF trusted origins - required for production behind reverse proxy
# CSRF_TRUSTED_ORIGINS=https://yourdomain.com
